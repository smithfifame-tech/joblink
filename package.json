    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fedapay": "^1.2.5",
    "geist": "^1.9.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "next": "15.5.29",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.91.0",
